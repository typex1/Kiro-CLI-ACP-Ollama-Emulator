[Unit]
Description=Kiro ACP Ollama Emulation Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/kiro-acp-ollama-emulator
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=/home/ubuntu/kiro-acp-ollama-emulator/.env

[Install]
WantedBy=multi-user.target
